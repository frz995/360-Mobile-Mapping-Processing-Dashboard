# =====================================================================
# GeoSphere 360 Processing Dashboard — Environment Variables
# Copy to `.env` and fill in real values. Every variable is optional;
# the app falls back to safe defaults when a variable is absent.
# Full usage-site mapping lives in docs/ENV.md.
# =====================================================================

# ─── Supabase (required for live data) ────────────────────────────────
VITE_SUPABASE_URL=https://tqqybumedywzylujjkqa.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Legacy alias (falls back to ANON_KEY if present)
# VITE_SUPABASE_KEY=YOUR_SUPABASE_KEY
# Primary storage bucket (default: MMS_PIC)
# VITE_SUPABASE_BUCKET=MMS_PIC
# VITE_STORAGE_BUCKET=MMS_PIC
# Bucket for oversized Road Analysis layer geometry (default: road-analysis-geometry)
# VITE_ROAD_GEOMETRY_BUCKET=road-analysis-geometry

# ─── WebGIS / Map iframe ──────────────────────────────────────────────
# Base URL of the embedded 360 map/WebGIS app. This is a SEPARATE app with
# its own repo and its own hosting (currently Vercel) — it is not deployed
# from this repository, so it is unaffected by this project's Pages deploy.
# Build-time inlined by Vite with no code fallback: if it is unset here and on
# Cloudflare Pages, every embedded map renders a blank iframe and a later fix
# requires a rebuild. Must also be set in the Cloudflare Pages project env.
# VITE_MAP_URL=https://mobilemapping-nine.vercel.app

# ─── Storage provider & CDN ───────────────────────────────────────────
# cloudflare_r2 | s3 | gcs | azure | wasabi | nas_local | supabase
# VITE_STORAGE_PROVIDER=cloudflare_r2
# VITE_R2_DOMAIN=https://your-r2-domain.example
# VITE_IMAGE_CDN_URL=https://your-cdn.example
# VITE_S3_BUCKET=your-s3-bucket
# VITE_S3_REGION=ap-southeast-1
# VITE_GCS_BUCKET=your-gcs-bucket
# VITE_AZURE_ACCOUNT=yourazureaccount
# VITE_AZURE_CONTAINER=your-container
# VITE_WASABI_BUCKET=your-wasabi-bucket
# VITE_WASABI_REGION=us-east-1

# ─── NAS / Production pipeline worker ─────────────────────────────────
# Two supported deployment profiles. See src/config/transport.ts.
#
# PROFILE A — Cloudflare Pages (production)
#   The browser is on a public HTTPS origin and cannot reach a private http://
#   IP, so everything on-prem is reached through same-origin /api/* Pages
#   Functions backed by a Cloudflare Tunnel. Set these on the Pages project:
#     VITE_WORKER_API_MODE=proxy        (default; may be omitted)
#     VITE_STATION_AGENT_MODE=proxy     (default; may be omitted)
#   plus the server-side secrets in docs/cloudflare_production_setup.md
#   (NAS_API_URL, NAS_WORKER_TOKEN, STATION_AGENT_URLS, STATION_AGENT_TOKENS).
#   NAS_API_URL / NAS_WORKER_TOKEN are NOT VITE_ vars: they stay server-side.
#
# PROFILE B — Local LAN development (`npm run dev`)
#   The worker is ONE service behind ONE token, so it is proxied in dev too —
#   the Vite dev server terminates the same /api/* routes, which keeps dev
#   behaviour identical to production and makes a laptop away from the office
#   work over the tunnel. Set BOTH of these in your untracked .env:
#     NAS_API_URL=https://your-tunnel-host
#     NAS_WORKER_TOKEN=the-worker-token
#   Leave VITE_WORKER_API_MODE unset (defaults to proxy). If they are missing
#   the UI reports "worker proxy is not configured" rather than inventing a NAS.
#
#   The four station agents are FOUR services with FOUR different tokens held
#   per-workstation in the UI, so no single env var can replace them: local dev
#   reaches them directly on the LAN (VITE_STATION_AGENT_MODE defaults to
#   direct). Set VITE_STATION_AGENT_MODE=proxy to route them through the
#   tunnel instead when working from outside the office.
#
# Overrides for unusual deployments:
#   VITE_WORKER_API_MODE=proxy|direct      default proxy
#   VITE_STATION_AGENT_MODE=proxy|direct  default proxy in prod, direct in dev
# VITE_NAS_SERVER_URL=http://nas-ip-or-hostname
# VITE_NAS_WORK_BASE_PATH=/Nas/360_raw
# VITE_PRODUCTION_API_URL=http://worker-host:8787   (only when MODE=direct)
# VITE_PRODUCTION_API_KEY=YOUR_WORKER_API_KEY       (only when MODE=direct)

# ─── Database table overrides (defaults in code, usually leave blank) ─
# VITE_DB_PANORAMAS_TABLE=panoramas
# VITE_DB_SUMMARY_VIEW=panoramas_subgrid_summary
# VITE_DB_BATCH_LOGS_TABLE=batch_logs
# VITE_DB_QA_DEFECTS_TABLE=qa_defects
# VITE_DB_QAQC_RUNS_TABLE=qaqc_audit_runs
# VITE_DB_AUDIT_LOGS_TABLE=audit_logs
# VITE_DB_STAGING_TABLE=staging_panoramas
# VITE_DB_NOTIFICATIONS_TABLE=notifications
# VITE_DB_PANORAMAS_TABLE=panoramas

# ─── Road extraction (Road Analysis workspace, Option A) ─────────────
# Provider route: 'overpass' (default) | 'custom' (future ML extractors)
# VITE_ROAD_EXTRACTION_ROUTE=overpass
# Client-side request is routed through the Cloudflare Pages Function
# (functions/api/road-extraction.js) to avoid browser CORS against public
# Overpass instances. Override the proxy endpoint here if it differs.
# VITE_ROAD_EXTRACTION_PROXY=/api/road-extraction
# Direct Overpass URL used ONLY as a local-development fallback when the
# proxy is unavailable. In production the proxy reads its own server-side
# VITE_ROAD_EXTRACTION_URL (set in the Cloudflare Pages project env), which is
# what actually matters.
# VITE_ROAD_EXTRACTION_URL=https://overpass-api.de/api/interpreter
# Set to '1' to skip the proxy entirely and always call Overpass directly
# (mainly for local troubleshooting; won't work from a deployed browser).
# VITE_ROAD_EXTRACTION_DIRECT=0
# Optional API key for non-default providers
# VITE_ROAD_EXTRACTION_KEY=

# ─── Observability ────────────────────────────────────────────────────
# Enable Sentry error reporting. When absent Sentry is a complete no-op.
# VITE_SENTRY_DSN=https://your-sentry-dsn@o123.ingest.sentry.io/456
# Dev-only: '1' suppresses non-fatal GPU/analysis console noise.
# VITE_DATA_QUIET=1
