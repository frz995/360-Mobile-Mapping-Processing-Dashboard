# tsc -b emitted a generated vite.config.js/.d.ts into the repo root before
# tsconfig.node.json was given an outDir under node_modules/.tmp. Ignored here so
# a stale local artifact can never be committed; nothing is emitted to the root
# any more, so this is belt-and-braces. vite.config.ts is the single source of
# truth and Vite reads it directly.
vite.config.js
vite.config.d.ts
tsconfig.node.tsbuildinfo

# Generated from supabase/migrations by scripts/bootstrap-migrations.mjs.
# The migrations are the source of truth; regenerate with `npm run
# migrations:bootstrap` rather than editing or committing the output.
supabase/bootstrap.sql

# Local scratch & temporary notes
scratch/
git clone supabase.txt
opencode.json
dev-smoke.log

# Exclude implementation plans, agent rules/issues, and internal documentation
implementation_plan*.md
.agents/

# docs/ is excluded wholesale, EXCEPT the documentation that has to ship with
# the repo: the client-facing setup guide, and the deployment-topology note a
# reseller reads before committing to a build per client. `docs/*` (not `docs/`)
# is required here: git cannot re-include a file whose parent directory is
# excluded.
docs/*
!docs/Production Setup/
!docs/Deployment-Topology.md

doc/
*.docx

