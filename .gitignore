# tsc -b emitted a generated vite.config.js/.d.ts into the repo root before
# tsconfig.node.json was given an outDir under node_modules/.tmp. Ignored here so
# a stale local artifact can never be committed; nothing is emitted to the root
# any more, so this is belt-and-braces. vite.config.ts is the single source of
# truth and Vite reads it directly.
vite.config.js
vite.config.d.ts
tsconfig.node.tsbuildinfo

# Local scratch & temporary notes
scratch/
git clone supabase.txt
opencode.json
dev-smoke.log

# Exclude implementation plans, agent rules/issues, and internal documentation
implementation_plan*.md
.agents/

# docs/ is excluded wholesale, EXCEPT the client-facing setup documentation,
# which ships with the repo. `docs/*` (not `docs/`) is required here: git cannot
# re-include a file whose parent directory is excluded.
docs/*
!docs/Production Setup/

doc/
*.docx

