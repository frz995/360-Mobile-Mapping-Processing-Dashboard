# GeoSphere 360 BFF gateway — required secrets (never commit real values).
# Copy to .env and fill in. See worker/bff/README.md.

# Supabase REST + service-role key (used to resolve app roles authoritatively).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# The on-prem NAS GPU Worker this gateway proxies to.
WORKER_BASE_URL=http://localhost:8000
NAS_WORKER_TOKEN=your-worker-shared-secret

# Comma-separated browser origins allowed through CORS.
# e.g. http://localhost:5173,https://dashboard.example.com
BFF_ALLOWED_ORIGINS=http://localhost:5173
