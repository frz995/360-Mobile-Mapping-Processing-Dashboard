# NAS Worker — environment template. Copy to `.env` and fill in.
# Run: `uvicorn app:app --host 0.0.0.0 --port 8000`

# NAS working base path — every folder path the dashboard sends resolves under
# this, and traversal outside it is rejected with HTTP 400.
NAS_BASE_PATH=C:\nas\360_images

# Shared secret. Every route except /health requires
# `Authorization: Bearer $NAS_WORKER_TOKEN` when this is set. The dashboard
# itself never holds this token: the Cloudflare Pages Functions and the Vite
# dev proxy read it from the server environment and inject the header. Set it on
# any non-loopback bind.
NAS_WORKER_TOKEN=

# Seconds a /api/storage response is cached before the volume is re-probed.
STORAGE_CACHE_TTL=30

# Emit structured JSON logs to stdout instead of human-readable lines ('1').
NAS_LOG_JSON=0

# Identifier stamped on /health so several workers behind one endpoint can be
# told apart. Defaults to the machine hostname when empty.
NAS_WORKER_ID=