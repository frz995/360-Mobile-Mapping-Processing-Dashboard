# NAS GPU Worker — environment template. Copy to `.env` and fill in.
# Run: `uvicorn app:app --host 0.0.0.0 --port 8000`

# NAS working base path — every source/output folder resolves under this.
# source_folder/output_folder are RELATIVE to this.
NAS_BASE_PATH=C:\nas\360_images

# Optional shared secret. Dashboard does not send it (read-only sync via service
# role); set API tokens for direct clients if your worker is LAN-exposed.
NAS_WORKER_TOKEN=

# Batch parallelism (GPU streams / workers). Start at 1, raise after pilot.
CONCURRENCY=1

# Optional: dashboard-sync via Supabase PostgREST (service role). Worker flips
# processing_jobs status/progress so the dashboard's job table stays live
# even without polling HTTP. Leave empty to run standalone.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Job admission control. SUBMIT is REJECTED while either limit is hit, so a
# runaway client cannot queue unbounded work against the GPU. MAX_ACTIVE_JOBS
# counts running jobs; MAX_QUEUE_DEPTH counts jobs accepted but not started.
MAX_ACTIVE_JOBS=1
MAX_QUEUE_DEPTH=20

# Seconds a storage/bucket inventory response is cached before it is re-probed.
STORAGE_CACHE_TTL=30

# Emit structured JSON logs to stdout instead of human-readable lines ('1').
NAS_LOG_JSON=0

# Identifier stamped on every log line and on /health, so several workers behind
# one endpoint can be told apart. Defaults to the machine hostname when empty.
NAS_WORKER_ID=

# Neighbor-aware mask warping: borrow pixels from adjacent frames when the
# current frame has no usable inpaint source. A per-job mask.useNeighborWarp
# setting also enables it; either one turning it on is enough.
MASK_NEIGHBOR_WARP=0

# Optional durable job journal (Stream B1). Set to a writable path to persist
# job state to SQLite so active jobs survive a worker restart (recovered jobs
# are surfaced as FAILED/interrupted for safe re-run). Leave empty to keep the
# historical in-memory-only behavior.
# WORKER_JOB_DB=C:\nas\worker_jobs.sqlite3