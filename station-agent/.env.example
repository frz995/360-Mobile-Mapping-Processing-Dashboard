# GeoSphere 360 Station Agent — per-PC configuration
# Copy this file to `.env` on EACH station PC and fill in the station's lines.

# --- Identity -----------------------------------------------------------------
# One of: blur | stitch | lightroom | photoshop
STATION_ID=stitch

# --- Watching -----------------------------------------------------------------
# Base NAS path as seen by THIS PC (mapped drive or UNC). The agent counts
# files under <WATCH_ROOT>/<OUT_STAGE>/<subgrid>/ for the Flight Board.
WATCH_ROOT=D:\\NAS\\360_images
# Optional override of the station's output stage; defaults are:
#   blur -> 02_Blurring   stitch -> 03_Stitching
#   lightroom -> 04_Lightroom   photoshop -> 05_Final
#OUT_STAGE=03_Stitching
# Optional input stage used by capture-point counting (default per station:
#   blur -> 00_Raw_data   stitch -> 02_Blurring
#   lightroom -> 03_Stitching   photoshop -> 04_Lightroom)
#IN_STAGE=00_Raw_data

# --- Capture-point mode (tile rigs) -------------------------------------------
# 1 = count progress in capture POINTS (a rig folder of camera tile dirs like
# <point>/1..6), not stitched images. Default: on for blur, off elsewhere.
#POINT_MODE=1
# A point is attributed to a subgrid when any path segment matches this regex
# (first match wins, e.g. .../N93E70/20220904/<point>).
#SUBGRID_PATTERN=^[A-Za-z]{1,3}[0-9A-Za-z]{2,11}$

# --- Process detection --------------------------------------------------------
# Comma/semicolon separated, lower-case, matched as substrings of the process
# name or exe path (psutil). Examples per station:
#   PC 1 (blur):      PROCESS_NAMES=privacykeeper.exe,blur
#   PC 2 (stitch):    PROCESS_NAMES=ptgui.exe,ptguipro.exe
#   PC 3 (lightroom): PROCESS_NAMES=lightroom.exe,lightroomclassic
#   PC 4 (photoshop): PROCESS_NAMES=photoshop.exe
PROCESS_NAMES=ptgui.exe,ptguipro.exe

# --- Engine -------------------------------------------------------------------
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
SCAN_INTERVAL_SEC=5
GROWING_WINDOW_SEC=90

# --- Security (optional) ------------------------------------------------------
# When set, dashboard probes must send `Authorization: Bearer <value>`.
#AGENT_TOKEN=
